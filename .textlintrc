{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 150
      },
      "no-exclamation-question-mark": false
    },
    "no-dead-link": {
      "ignore": [
        "https://calendar.google.com/*",
        "https://docs.google.com/*",
        "https://forms.gle/*"
      ],
      "checkRelative": true,
      "retry": 3
    }
  }
}
