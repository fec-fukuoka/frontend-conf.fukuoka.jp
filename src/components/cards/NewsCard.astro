---
export interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  lang: "ja" | "en";
}

const { id, title, description, pubDate, lang } = Astro.props;

// Format date
const formattedDate = new Intl.DateTimeFormat(
  lang === "ja" ? "ja-JP" : "en-US",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  }
).format(pubDate);
---

<article class="news-card">
  <a href={`/2026/news/${id}?hl=${lang}`} class="news-card__link">
    <time datetime={pubDate.toISOString()} class="news-card__date">
      {formattedDate}
    </time>
    <div class="news-card__content">
      <h3 class="news-card__title">{title}</h3>
      <p class="news-card__description">{description}</p>
      <span class="news-card__cta">
        <svg
          class="news-card__arrow"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <title>Read more about {title}</title>
          <path
            d="M4 10H16M16 10L11 5M16 10L11 15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  @layer components {
    .news-card {
      container-type: inline-size;
      container-name: news-card;
      height: fit-content;

      &:nth-child(odd) .news-card__link:hover {
        transform: translateY(-2px);
        box-shadow: -5px -5px var(--color-conf-blue);
      }
      &:nth-child(even) .news-card__link:hover {
        transform: translateY(-2px);
        box-shadow: 5px 5px var(--color-conf-red);
      }
    }

    .news-card__link {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
      background: var(--color-surface-base);
      border: 0.5px solid white;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .news-card__date {
      color: var(--color-text-tertiary);
      text-transform: uppercase;
    }

    .news-card__content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      flex: 1;
    }

    .news-card__title {
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--color-text-primary);
      margin: 0;
      line-height: 1.3;
    }

    .news-card__description {
      color: var(--color-text-secondary);
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      flex: 1;
    }

    .news-card__cta {
      display: inline-flex;
      align-items: center;
      margin-top: auto;
      width: fit-content;
    }

    .news-card__arrow {
      color: var(--color-conf-red);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .news-card__link:hover .news-card__arrow {
      transform: translateX(4px);
    }

    /* Container query adjustments */
    @container news-card (min-width: 400px) {
      .news-card__link {
        padding: 2rem;
        gap: 1.25rem;
      }
    }

    @container news-card (min-width: 600px) {
      .news-card__link {
        flex-direction: row;
        align-items: flex-start;
      }

      .news-card__date {
        min-width: 120px;
        flex-shrink: 0;
      }

      .news-card__description {
        -webkit-line-clamp: 2;
      }
    }
  }
</style>
