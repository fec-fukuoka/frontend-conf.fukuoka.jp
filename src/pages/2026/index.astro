---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import NewsCard from "../../components/cards/NewsCard.astro";
import { getEventByYear } from "../../data/events";
import { getLangFromRequest, useTranslations } from "../../i18n/utils";
import sponsorsData from "../../data/sponsors.json";

const lang = getLangFromRequest(Astro.request, Astro.url);
const t = useTranslations(lang);

const event = getEventByYear(2026);
if (!event) {
  return Astro.redirect("/404");
}

// Get news items for the detected language
const newsItems = await getCollection("news", ({ data }) => {
  return data.locale === lang && data.year === 2026 && !data.draft;
});

// Latest news only (3 items)
const latestNews = newsItems
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Sponsors by tier
const sponsorsByTier = {
  platinum: sponsorsData.filter((s) => s.tier === "platinum"),
  gold: sponsorsData.filter((s) => s.tier === "gold"),
  silver: sponsorsData.filter((s) => s.tier === "silver"),
  bronze: sponsorsData.filter((s) => s.tier === "bronze"),
  community: sponsorsData.filter((s) => s.tier === "community"),
  supporter: sponsorsData.filter((s) => s.tier === "supporter"),
};

// Event information based on language
const eventTitle = lang === "ja" ? event.title : event.titleEn;
const eventDescription =
  lang === "ja" ? event.description : event.descriptionEn;
---

<PageLayout
  title={eventTitle}
  description={eventDescription}
  lang={lang}
  isHome={true}
>
  <div class="container">
    <section class="news">
      <div class="section-header">
        <h2 class="section-title">{t("news.title")}</h2>
        <a href={`/2026/news?hl=${lang}`} class="view-all">
          {t("button.viewAll")} →
        </a>
      </div>
      <div class="news-list">
        {
          latestNews.map((item) => (
            <NewsCard
              id={item.id.replace(/^.*\//, "").replace(".md", "")}
              title={item.data.title}
              description={item.data.description}
              pubDate={item.data.pubDate}
              lang={lang}
            />
          ))
        }
      </div>
    </section>

    <section class="sponsors">
      <h2 class="section-title sponsors-title">{t("sponsors.title")}</h2>
      {
        sponsorsByTier.platinum.length > 0 && (
          <div class="sponsors__section">
            <h3 class="sponsors__tier-title">Platinum Sponsors</h3>
            <div class="sponsors__grid sponsors__grid--platinum">
              {sponsorsByTier.platinum.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsors__item"
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class="sponsors__logo"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
      {
        sponsorsByTier.gold.length > 0 && (
          <div class="sponsors__section">
            <h3 class="sponsors__tier-title">Gold Sponsors</h3>
            <div class="sponsors__grid sponsors__grid--gold">
              {sponsorsByTier.gold.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsors__item"
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class="sponsors__logo"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
      {
        sponsorsByTier.silver.length > 0 && (
          <div class="sponsors__section">
            <h3 class="sponsors__tier-title">Silver Sponsors</h3>
            <div class="sponsors__grid sponsors__grid--silver">
              {sponsorsByTier.silver.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsors__item"
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class="sponsors__logo"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
      {
        sponsorsByTier.bronze.length > 0 && (
          <div class="sponsors__section">
            <h3 class="sponsors__tier-title">Bronze Sponsors</h3>
            <div class="sponsors__grid sponsors__grid--bronze">
              {sponsorsByTier.bronze.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsors__item"
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class="sponsors__logo"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
      {
        sponsorsByTier.community.length > 0 && (
          <div class="sponsors__section">
            <h3 class="sponsors__tier-title">Community Sponsors</h3>
            <div class="sponsors__grid sponsors__grid--community">
              {sponsorsByTier.community.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsors__item"
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class="sponsors__logo"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
      {
        sponsorsByTier.supporter.length > 0 && (
          <div class="sponsors__section">
            <h3 class="sponsors__tier-title">Special Supporter</h3>
            <div class="sponsors__grid sponsors__grid--supporter">
              {sponsorsByTier.supporter.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsors__item"
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class="sponsors__logo"
                  />
                </a>
              ))}
            </div>
          </div>
        )
      }
      <p class="sponsor-info">
        {t("sponsors.recruiting")}<a
          href="https://docs.google.com/presentation/d/1i7vePglNPltZtGSOBZVaNk1XvYWu9N6FWc6qfmDYWgY/edit?usp=sharing"
          target="_blank"
          rel="noopener noreferrer">{t("sponsors.recruitingLinkText")}</a
        >
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .container {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 2 / 3;
  }
  .section-header {
    margin-block-end: 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .section-title {
    color: var(--color-text-primary);
    margin: 0;
  }

  .view-all {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .view-all:hover {
    color: var(--color-text-primary);
  }

  .sponsors {
    margin-block-start: 8rem;
  }

  .sponsors-title {
    margin-block-end: 4rem;
    text-align: center;
  }

  .sponsors {
    container-type: inline-size;
    container-name: sponsors;
    padding: 4rem 0;
  }

  .sponsors__section {
    margin-block-end: 4rem;
  }

  .sponsors__section:last-child {
    margin-block-end: 0;
  }

  .sponsors__tier-title {
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin: 0 0 2rem 0;
    text-align: center;
  }

  .sponsors__grid {
    container-type: inline-size;
    container-name: sponsor-grid;
    display: grid;
    gap: 1.5rem;
    align-items: center;
    justify-items: center;
  }

  /* Platinum sponsors - largest */
  .sponsors__grid--platinum {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  }

  /* Gold sponsors */
  .sponsors__grid--gold {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  /* Silver sponsors */
  .sponsors__grid--silver {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
  }

  /* Bronze sponsors */
  .sponsors__grid--bronze {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
  }

  /* Community sponsors - smallest */
  .sponsors__grid--community {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 120px), 1fr));
  }

  /* supporter sponsors - smallest */
  .sponsors__grid--supporter {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 120px), 1fr));
  }

  @layer components {
    .sponsors__item {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: white;
      border: 1px solid var(--color-border-subtle);
      border-radius: 8px;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
      overflow: hidden;
    }

    .sponsors__item:hover {
      transform: translateY(-2px);
      border-color: var(--color-border-hover);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .sponsors__logo {
      width: 60%;
      aspect-ratio: 1 / 1;
      padding: 1rem;
      object-fit: contain;
    }

    .sponsors__item:hover .sponsors__logo {
      filter: brightness(110%);
      opacity: 0.95;
    }

    @container sponsor-grid (min-width: 768px) {
      .sponsors__grid--platinum {
        grid-template-columns: repeat(2, 1fr);
      }

      .sponsors__grid--gold {
        grid-template-columns: repeat(3, 1fr);
      }

      .sponsors__grid--silver {
        grid-template-columns: repeat(4, 1fr);
      }

      .sponsors__grid--bronze {
        grid-template-columns: repeat(4, 1fr);
      }

      .sponsors__grid--community {
        grid-template-columns: repeat(5, 1fr);
      }
    }

    @container sponsor-grid (min-width: 1200px) {
      .sponsors__grid--platinum {
        grid-template-columns: repeat(3, 1fr);
      }

      .sponsors__grid--gold {
        grid-template-columns: repeat(4, 1fr);
      }

      .sponsors__grid--silver {
        grid-template-columns: repeat(5, 1fr);
      }

      .sponsors__grid--bronze {
        grid-template-columns: repeat(6, 1fr);
      }

      .sponsors__grid--community {
        grid-template-columns: repeat(6, 1fr);
      }
    }
  }
</style>
