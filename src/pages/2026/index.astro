---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import NewsCard from "../../components/cards/NewsCard.astro";
import SubEventCard from "../../components/cards/SubEventCard.astro";
import SponsorsEmbed from "../../components/SponsorsEmbed.astro";
import { getEventByYear } from "../../data/events";
import { getLangFromRequest, useTranslations } from "../../i18n/utils";
import supportersData from "../../data/supporters.json";
import { SUB_EVENT_SUBMIT_URL } from "../../lib/sub-events/constants";
import { filterByEditionYear } from "../../lib/sub-events/github";
import type { SubEvent } from "../../lib/sub-events/types";

const EDITION_YEAR = 2026;

const lang = getLangFromRequest(Astro.request, Astro.url);
const t = useTranslations(lang);

const event = getEventByYear(2026);
if (!event) {
  return Astro.redirect("/404");
}

// Get news items for the detected language
const newsItems = await getCollection("news", ({ data }) => {
  return data.locale === lang && data.year === 2026 && !data.draft;
});

// Latest news only (3 items)
const latestNews = newsItems
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// Organizers (GitHub usernames)
const organizers = supportersData.organizers;

// Community sub-events (via cached /api/sub-events, upcoming only, max 3)
let subEvents: SubEvent[] = [];
let subEventsFailed = false;
try {
  const response = await fetch(new URL("/api/sub-events", Astro.url.origin));
  if (!response.ok) {
    throw new Error(`/api/sub-events responded ${response.status}`);
  }
  subEvents = filterByEditionYear(
    (await response.json()) as SubEvent[],
    EDITION_YEAR
  );
} catch (error) {
  console.error("[sub-events] failed to fetch /api/sub-events:", error);
  subEventsFailed = true;
}
const upcomingSubEvents = subEvents
  .filter((event) => new Date(event.endsAt).getTime() >= Date.now())
  .slice(0, 3);

// Event information based on language
const eventTitle = lang === "ja" ? event.title : event.titleEn;
const eventDescription =
  lang === "ja" ? event.description : event.descriptionEn;
---

<PageLayout
  title={eventTitle}
  description={eventDescription}
  lang={lang}
  isHome={true}
>
  <div class="container">
    <section class="schedule">
      <h2 class="section-title">{t("schedule.title")}</h2>
      <p class="schedule-note">{t("schedule.note")}</p>
      <ul class="schedule-list" id="schedule-list" data-lang={lang}>
        <li class="schedule-item schedule-loading">
          {lang === "ja" ? "読み込み中..." : "Loading..."}
        </li>
      </ul>
      <a
        href="https://calendar.google.com/calendar/u/0?cid=NjA0MTRlMzgwMmYyMjY3NWQ2YmU3MzhjMjExYTNkNWUzYmMwMjQ3ZGNlNTNiMjA1MDBkNjRlOWY2MzEzNjY0YkBncm91cC5jYWxlbmRhci5nb29nbGUuY29t"
        target="_blank"
        rel="noopener noreferrer"
        class="calendar-link"
      >
        🗓️ {t("schedule.addToCalendar")}
      </a>
    </section>

    <section class="news">
      <div class="section-header">
        <h2 class="section-title">{t("news.title")}</h2>
      </div>
      <div class="news-list">
        {
          latestNews.map((item) => (
            <NewsCard
              id={item.id.replace(/^.*\//, "").replace(".md", "")}
              title={item.data.title}
              description={item.data.description}
              pubDate={item.data.pubDate}
              lang={lang}
            />
          ))
        }
      </div>
      <div class="news-actions">
        <!-- スクリーンリーダー等のリンク一覧で意味不明にならないようにaria-labelではニュースの一覧ページへのリンクであることを明示 -->
        <a
          href={`/2026/news?hl=${lang}`}
          class="view-all"
          aria-label={t("news.viewAllAriaLabel")}
        >
          {t("button.viewAll")} →
        </a>
      </div>
    </section>

    <section class="sub-events-home">
      <h2 class="section-title">{t("subEvents.title")}</h2>
      <p class="sub-events-home__intro">{t("subEvents.intro")}</p>
      <div class="sub-events-home__actions">
        <a
          href={SUB_EVENT_SUBMIT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="sub-events-home__submit"
          aria-label={t("subEvents.submitAria")}
        >
          {t("subEvents.submit")}
        </a>
      </div>
      {
        subEventsFailed && (
          <p class="sub-events-home__message">{t("subEvents.loadError")}</p>
        )
      }
      {
        !subEventsFailed && upcomingSubEvents.length === 0 && (
          <p class="sub-events-home__message">{t("subEvents.empty")}</p>
        )
      }
      {
        upcomingSubEvents.length > 0 && (
          <div class="sub-events-home__list">
            {upcomingSubEvents.map((event) => (
              <SubEventCard event={event} lang={lang} />
            ))}
          </div>
        )
      }
      <div class="sub-events-home__more">
        <a
          href={`/2026/sub-events?hl=${lang}`}
          class="view-all"
          aria-label={t("subEvents.viewAllAriaLabel")}
        >
          {t("button.viewAll")} →
        </a>
      </div>
    </section>

    <section class="sponsors">
      <h2 class="section-title sponsors-title">{t("sponsors.title")}</h2>
      <SponsorsEmbed />
      <p class="sponsor-info">
        {t("sponsors.recruiting")}
      </p>
    </section>

    <section class="organizers">
      <h2 class="section-title organizers-title">{t("organizers.title")}</h2>
      <div class="organizers__grid">
        {
          organizers.map((id) => (
            <a
              href={`https://github.com/${id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="organizers__member"
            >
              <img
                src={`https://github.com/${id}.png?size=120`}
                alt={id}
                class="organizers__avatar"
                width="120"
                height="120"
                loading="lazy"
                decoding="async"
              />
              <span class="organizers__id">@{id}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .container {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 2 / 3;
  }
  .section-header {
    margin-block-end: 4rem;
  }

  .section-title {
    color: var(--color-text-primary);
    margin: 0;
  }

  .view-all {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .view-all:hover {
    color: var(--color-text-primary);
  }

  .news-actions {
    display: flex;
    justify-content: center;
    margin-block-start: 2rem;
  }

  .schedule {
    margin-block-end: 4rem;
  }

  .schedule .section-title,
  .schedule-note {
    margin-block-end: 2rem;
  }

  .schedule-list {
    list-style: disc;
    padding-inline-start: 1.5rem;
    margin: 0;
  }

  .schedule-item {
    color: var(--color-text-primary);
    margin-block-end: 0.75rem;
    line-height: 1.6;
  }

  .schedule-item strong {
    font-weight: 600;
  }

  .schedule-sublist {
    list-style: circle;
    padding-inline-start: 1.5rem;
    margin-block-start: 0.25rem;
    margin-block-end: 0.5rem;
  }

  .schedule-sublist li {
    margin-block-end: 0.25rem;
  }

  .schedule-sublist a,
  .schedule-item a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    transition: color 0.3s ease;
  }

  .schedule-sublist a:hover,
  .schedule-item a:hover {
    color: var(--color-text-primary);
  }

  .calendar-link {
    display: inline-block;
    margin-block-start: 1.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .calendar-link:hover {
    color: var(--color-text-primary);
  }

  .sub-events-home {
    container-type: inline-size;
    container-name: sub-events-home;
    margin-block-start: 8rem;
    padding: 2rem;
    border: 1px solid var(--color-border-subtle);
    box-shadow: 8px 8px var(--color-conf-pink);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sub-events-home__intro,
  .sub-events-home__message {
    color: var(--color-text-secondary);
    margin: 0;
  }

  @layer components {
    .sub-events-home__submit {
      display: inline-block;
      width: fit-content;
      padding: 0.75rem 1.5rem;
      background: var(--color-conf-red);
      color: white;
      text-decoration: none;
      border-block-end: none;
      font-weight: 600;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);

      &:hover {
        transform: translateY(-2px);
        box-shadow: 5px 5px var(--color-conf-blue);
      }
    }
  }

  .sub-events-home__list {
    display: grid;
    gap: 2rem;
  }

  .sub-events-home__more {
    display: flex;
    justify-content: center;
  }

  @container sub-events-home (min-width: 600px) {
    .sub-events-home {
      padding: 3rem;
    }
  }

  .sponsors {
    margin-block-start: 8rem;
  }

  .sponsors-title {
    margin-block-end: 4rem;
    text-align: center;
  }

  .sponsors {
    container-type: inline-size;
    container-name: sponsors;
    padding-block: 4rem;
  }

  .schedule-loading {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .schedule-error {
    color: var(--color-text-secondary);
  }

  :global(.schedule-item--past) {
    color: var(--color-text-tertiary);
  }

  :global(.schedule-item--past) strong {
    font-weight: 500;
  }

  :global(.schedule-item--upcoming) {
    color: var(--color-text-primary);
  }

  :global(.schedule-item--upcoming) strong {
    font-weight: 600;
  }

  .organizers {
    margin-block-start: 8rem;
    padding-block: 4rem;
  }

  .organizers-title {
    margin-block-end: 3rem;
    text-align: center;
  }

  .organizers__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 100px), 1fr));
    gap: 0.5rem;
    place-items: center;
    margin-inline: auto;
  }

  .organizers__member {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .organizers__member:hover {
    transform: translateY(-2px);
  }

  .organizers__avatar {
    inline-size: 50px;
    block-size: 50px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border-subtle);
    transition: border-color 0.3s ease;
  }

  .organizers__member:hover .organizers__avatar {
    border-color: var(--color-border-hover);
  }

  .organizers__id {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    transition: color 0.3s ease;
    text-align: center;
    word-break: break-all;
  }

  .organizers__member:hover .organizers__id {
    color: var(--color-text-primary);
  }

  .news-list {
    display: grid;
    gap: 2rem;
  }
</style>

<script src="../../scripts/schedule-loader.ts"></script>
