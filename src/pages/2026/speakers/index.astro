---
import { getCollection } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getLangFromRequest, useTranslations } from "../../../i18n/utils";

const lang = getLangFromRequest(Astro.request, Astro.url);
const t = useTranslations(lang);

// Get speakers for the detected language
const speakers = await getCollection("speakers", ({ data }) => {
  return data.locale === lang && data.year === 2026 && !data.draft;
});

// Sort by track and start time
const sortedSpeakers = speakers.sort((a, b) => {
  if (a.data.track !== b.data.track) {
    return a.data.track.localeCompare(b.data.track);
  }
  return a.data.startTime.localeCompare(b.data.startTime);
});
---

<PageLayout
  title={t("speakers.title")}
  description={t("speakers.description")}
  lang={lang}
>
  <div class="container">
    <h1 class="page-title">{t("speakers.title")}</h1>

    <div class="speakers-grid">
      {
        sortedSpeakers.map((speaker) => (
          <a
            href={`/2026/speakers/${speaker.id.replace(/^.*\//, "").replace(".md", "")}?hl=${lang}`}
            class="speaker-card"
          >
            {speaker.data.image && (
              <div class="speaker-card__image-wrapper">
                <img
                  src={speaker.data.image}
                  alt={speaker.data.name}
                  class="speaker-card__image"
                />
              </div>
            )}
            <div class="speaker-card__content">
              <h2 class="speaker-card__name">{speaker.data.name}</h2>
              <p class="speaker-card__title">{speaker.data.sessionTitle}</p>
              <span class="speaker-card__category">
                {speaker.data.sessionCategory}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</PageLayout>

<style>
  @layer components {
    .speakers-grid {
      container-type: inline-size;
      container-name: speakers;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
      gap: 2rem;
      padding: 2rem 0;
    }

    .speaker-card {
      container-type: inline-size;
      container-name: card;
      background: var(--color-surface-base);
      border: 1px solid var(--color-border-subtle);
      border-radius: 8px;
      padding: 1.5rem;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
      color: inherit;
      display: block;
      position: relative;
      overflow: hidden;
    }

    .speaker-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--color-surface-base);
      opacity: 0;
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 0;
    }

    .speaker-card:hover {
      transform: translateY(-2px);
      border-color: var(--color-border-hover);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .speaker-card:hover::before {
      opacity: 1;
    }

    .speaker-card__image-wrapper {
      width: 100%;
      aspect-ratio: 1;
      border-radius: 6px;
      overflow: hidden;
      margin-block-end: 1rem;
      background: var(--color-surface-elevated);
      position: relative;
      z-index: 1;
    }

    .speaker-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .speaker-card:hover .speaker-card__image {
      transform: scale(1.02);
    }

    .speaker-card__content {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      position: relative;
      z-index: 1;
    }

    .speaker-card__name {
      margin: 0;
    }

    .speaker-card__title {
      color: var(--color-text-secondary);
      margin: 0;
    }

    .speaker-card__category {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.875rem;
      width: fit-content;
      background: var(--color-surface-elevated);
      color: var(--color-text-secondary);
      border: 1px solid var(--color-border-subtle);
      border-radius: 100px;
      margin-block-start: 0.75rem;
    }

    @container card (min-width: 400px) {
      .speaker-card {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      .speaker-card__image-wrapper {
        margin-block-end: 0;
      }
    }

    @container card (min-width: 600px) {
      .speaker-card {
        grid-template-columns: 160px 1fr;
      }
    }

    @container speakers (min-width: 768px) {
      .speakers-grid {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 350px), 1fr));
      }
    }

    @container speakers (min-width: 1200px) {
      .speakers-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 2.5rem;
      }
    }
  }
</style>
