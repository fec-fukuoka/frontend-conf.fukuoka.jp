---
import { getCollection } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getLangFromRequest, useTranslations } from "../../../i18n/utils";
import CategoryTag from "../../../components/CategoryTag.astro";

const lang = getLangFromRequest(Astro.request, Astro.url);
const t = useTranslations(lang);

// Get speakers for the detected language
const speakers = await getCollection("speakers", ({ data }) => {
  return data.locale === lang && data.year === 2026 && !data.draft;
});

// Sort by speaker name
const sortedSpeakers = speakers.sort((a, b) => {
  return a.data.name.localeCompare(b.data.name);
});
---

<PageLayout
  title={t("speakers.title")}
  description={t("speakers.description")}
  lang={lang}
>
  <div class="container">
    <h1 class="page-title">{t("speakers.title")}</h1>

    <div class="speakers-grid">
      {
        sortedSpeakers.map((speaker, index) => (
          <article>
            <a
              href={`/2026/speakers/${speaker.id.replace(/^.*\//, "").replace(".md", "")}?hl=${lang}`}
              class="speaker-card"
            >
              {speaker.data.image && (
                <div class="speaker-card__image-wrapper">
                  <img
                    src={speaker.data.image}
                    alt={speaker.data.name}
                    class="speaker-card__image"
                    width="400"
                    height="400"
                    loading={index < 4 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <div class="filter-overlay" />
                </div>
              )}
              <div class="speaker-card__content">
                <h2 class="speaker-card__name">{speaker.data.name}</h2>
                <p class="speaker-card__title">{speaker.data.sessionTitle}</p>
                <CategoryTag
                  class="speaker-card__category"
                  category={speaker.data.sessionCategory}
                />
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</PageLayout>

<style>
  .container {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    .page-title {
      grid-column: 2 / 3;
    }
    .speakers-grid {
      grid-column: 1 / -1;
      container-type: inline-size;
      container-name: speakers;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
      gap: 1rem;
      padding-inline: 2rem;
      max-width: max(80vw, 350px);
      margin-inline: auto;
      width: 100%;
    }
  }

  @layer components {
    .speaker-card {
      container-type: inline-size;
      container-name: card;
      border: none;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      display: grid;
      gap: 1.5rem;
      block-size: 100%;
    }

    .speakers-grid > article {
      display: grid;
    }

    .speakers-grid > article:nth-child(4n) {
      .filter-overlay {
        background: var(--color-conf-pink);
      }
      .speaker-card:hover {
        transform: translateY(-2px);
        box-shadow: 5px 5px var(--color-conf-red);
        .filter-overlay {
          opacity: 1;
        }
      }
    }

    .speakers-grid > article:nth-child(4n + 1) {
      .filter-overlay {
        background: var(--color-conf-pink);
      }
      .speaker-card:hover {
        transform: translateY(-2px);
        box-shadow: 5px 5px var(--color-conf-orange);
        .filter-overlay {
          opacity: 1;
        }
      }
    }
    .speakers-grid > article:nth-child(4n + 2) {
      .filter-overlay {
        background: var(--color-conf-pink);
      }
      .speaker-card:hover {
        transform: translateY(-2px);
        box-shadow: 5px 5px var(--color-conf-cyan);
        .filter-overlay {
          opacity: 1;
        }
      }
    }
    .speakers-grid > article:nth-child(4n + 3) {
      .filter-overlay {
        background: var(--color-conf-pink);
      }
      .speaker-card:hover {
        transform: translateY(-2px);
        box-shadow: 5px 5px var(--color-conf-blue);
        .filter-overlay {
          opacity: 1;
        }
      }
    }

    .speaker-card__image-wrapper {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }

    .filter-overlay {
      position: absolute;
      inset: 0;
      opacity: 0;
      mix-blend-mode: screen;
      pointer-events: none;
      transition: opacity 150ms cubic-bezier(0.6, 0, 0.4, 1);
    }

    .speaker-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .speaker-card:hover .speaker-card__image {
      transform: scale(1.02);
    }

    .speaker-card__content {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .speaker-card__name {
      margin: 0;
    }

    .speaker-card__title {
      color: var(--color-text-secondary);
      margin: 0;
    }

    .speaker-card__category {
      margin-block-start: 0.5rem;
    }

    @container card (min-width: 400px) {
      .speaker-card {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      .speaker-card__image-wrapper {
        margin-block-end: 0;
      }
    }

    @container card (min-width: 600px) {
      .speaker-card {
        grid-template-columns: 160px 1fr;
      }
    }
  }
</style>
