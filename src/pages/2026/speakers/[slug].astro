---
import { getCollection, render } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";
import { getLangFromRequest, useTranslations } from "../../../i18n/utils";

const lang = getLangFromRequest(Astro.request, Astro.url);
const t = useTranslations(lang);
const { slug } = Astro.params;

// Find the speaker by slug and language
const speakers = await getCollection("speakers", ({ data }) => {
  return data.locale === lang && data.year === 2026 && !data.draft;
});

const speaker = speakers.find(
  (s) => s.id.replace(/^.*\//, "").replace(".md", "") === slug
);

if (!speaker) {
  return Astro.redirect("/404");
}

const { Content } = await render(speaker);
---

<PageLayout
  title={`${speaker.data.name} - ${speaker.data.sessionTitle}`}
  description={speaker.data.bio}
  lang={speaker.data.locale}
>
  <div class="container">
    <article class="speaker-detail">
      <section class="session-info">
        <h1>{speaker.data.sessionTitle}</h1>
        <div class="session-meta">
          <span class="category">{speaker.data.sessionCategory}</span>
          <span class="track">{speaker.data.track}</span>
          <span class="time">
            {speaker.data.startTime} - {speaker.data.endTime}
          </span>
          <span class="language">
            {t("label.language")}: {speaker.data.language}
          </span>
        </div>
        <div class="session-description">
          <Content />
        </div>
      </section>
      <header class="speaker-header">
        {
          speaker.data.image && (
            <img
              src={speaker.data.image}
              alt={speaker.data.name}
              class="speaker-avatar"
            />
          )
        }
        <div class="speaker-meta">
          <h2>{speaker.data.name}</h2>
          <p class="bio">{speaker.data.bio}</p>
          <div class="social-links">
            {
              speaker.data.twitter && (
                <a
                  href={`https://twitter.com/${speaker.data.twitter}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Twitter
                </a>
              )
            }
            {
              speaker.data.github && (
                <a
                  href={`https://github.com/${speaker.data.github}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub
                </a>
              )
            }
            {
              speaker.data.website && (
                <a
                  href={speaker.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Website
                </a>
              )
            }
          </div>
        </div>
      </header>
    </article>
  </div>
</PageLayout>

<style>
  .container {
    container-type: inline-size;
  }

  .speaker-header {
    display: grid;
    grid-template:
      "avatar" auto
      "meta" auto
      / 1fr;
    gap: var(--space-m-l, 1.5rem);
    margin-block-end: var(--space-l-xl, 3rem);
    padding: var(--space-m-l, 1.5rem);
    border-radius: 0.5rem;
    background: var(--color-surface-base);
    border: 1px solid var(--color-border-subtle);
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }

  .speaker-avatar {
    grid-area: avatar;
    width: 100%;
    max-width: 200px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--color-border-default);
    justify-self: center;
    transition:
      transform 0.3s ease,
      border-color 0.3s;
  }

  .speaker-avatar:hover {
    transform: scale(1.05);
    border-color: var(--color-border-hover);
  }

  .speaker-meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs-s, 1rem);
  }

  .bio {
    margin: 0;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs-xs, 0.75rem);
  }

  .social-links a {
    padding: var(--space-2xs-xs, 0.5rem) var(--space-xs-s, 1rem);
    background: var(--color-accent-red-subtle);
    color: var(--color-conf-red);
    text-decoration: none;
    border-radius: 0.25rem;
    border: 1px solid var(--color-accent-red-border);
    font-weight: 500;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .social-links a:hover {
    background: var(--color-accent-red-hover);
    border-color: var(--color-conf-red);
    transform: translateY(-2px);
  }

  .session-description {
    margin-block-end: var(--gutter-m);
  }

  /* Container query for medium screens */
  @container (width > 27em) {
    .speaker-header {
      grid-template:
        "avatar meta" auto
        / clamp(8rem, 25%, 15rem) 1fr;
      gap: var(--space-l-xl, 2rem);
      align-items: start;
    }

    .speaker-avatar {
      justify-self: start;
    }
  }

  /* Container query for large screens */
  @container (width > 48em) {
    .speaker-header {
      grid-template:
        "avatar meta" auto
        / clamp(12rem, 30%, 20rem) 1fr;
      gap: var(--space-l-xl, 2.5rem);
      padding: var(--space-l-xl, 2rem);
    }

    .speaker-meta {
      gap: var(--space-s-m, 1.5rem);
    }
  }

  /* Container query for extra large screens */
  @container (width > 64em) {
    .speaker-avatar {
      max-width: 250px;
    }
  }
</style>
