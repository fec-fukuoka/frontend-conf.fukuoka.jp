---
import PageLayout from "../../layouts/PageLayout.astro";
import TimetableEmbed from "../../components/TimetableEmbed.astro";
import { getLangFromRequest, useTranslations } from "../../i18n/utils";

const lang = getLangFromRequest(Astro.request, Astro.url);
const t = useTranslations(lang);
---

<PageLayout
  title={t("timetable.title")}
  description={t("timetable.description")}
  lang={lang}
>
  <div class="container">
    <h1 class="page-title">{t("timetable.title")}</h1>
    <div class="tt-page">
      <TimetableEmbed lang={lang} />
    </div>
  </div>
</PageLayout>

<style>
  .container {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  .page-title,
  .tt-page {
    grid-column: 1 / -1;
    inline-size: 100%;
    max-inline-size: min(900px, 92vw);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
</style>
